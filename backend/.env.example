# ==============================================================================
# EventMate AI: Backend Environment Variables
# ==============================================================================

# --- AI Service Configuration ---
# Secret API key for Google Gemini. If omitted or blank, the backend operates in truthful Demo Mode.
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Server & Network ---
# Host and port for the local Uvicorn development server
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins (trailing slashes stripped automatically)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional regular expression matching allowed CORS origins (useful for Vercel preview domains)
# Example: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Trust X-Forwarded-For proxy headers when extracting client IP behind Render/Cloudflare/Nginx
TRUST_PROXY_HEADERS=false

# --- Database Storage ---
# SQLite file or PostgreSQL connection string. Defaults to SQLite file in backend directory if unset.
# SQLite example: sqlite:///eventmate.db
# PostgreSQL example: postgresql+psycopg://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///eventmate.db

# --- Rate Limiting & Safety Controls ---
# Maximum AI generation and assistant requests allowed per minute per client IP (0 disables)
AI_RATE_LIMIT_PER_MINUTE=10

# Expiration window in minutes for unconfirmed AI change proposals (default: 15)
PROPOSAL_TTL_MINUTES=15

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
